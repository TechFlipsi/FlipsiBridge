<?xml version="1.0" encoding="utf-8"?>
<!-- PH-7 / PS-G-1 (11.11.2026): Play-Edition Manifest-Overlay.
     Schneidet die Play-restricted Berechtigungen aus dem Merge (tools:node="remove")
     und deklariert das Launcher-Query-Intent als Package-Visibility-Ersatz für
     QUERY_ALL_PACKAGES (PS-A-10). Der Codepfad bleibt EIN Weg — Feature-Branches
     laufen über BuildConfig (Dispatcher/Executor/Gate/Resolver/RelayClient).

     Entfernt im play-Build (ROADMAP PS-A):
       - REQUEST_INSTALL_PACKAGES            (#11  Selbst-Update verboten)
       - QUERY_ALL_PACKAGES                  (#10  Restricted; Launcher-Query reicht)
       - SEND_SMS                            (#14  Restricted; Ersatz = SMS-Intent-Entwurf)
       - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (#18 Restricted; Ersatz = Settings-Liste)
       - com.termux.permission.RUN_COMMAND   (PS-G-7-Default: raus)
     Behalten laut PS-A (Deklarations-/Disclosure-Arbeit = PH-8/9):
       MANAGE_EXTERNAL_STORAGE (#9, File-Use-Case-Deklaration), CALL_PHONE (#15),
       Accessibility/Notification-Listener/Health (#19-21) etc. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <!-- /apps-Inventar ohne QUERY_ALL_PACKAGES: alle Apps mit Launcher-Intent. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />
    <uses-permission
        android:name="com.termux.permission.RUN_COMMAND"
        tools:node="remove" />
</manifest>
