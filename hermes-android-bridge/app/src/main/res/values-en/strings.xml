<?xml version="1.0" encoding="utf-8"?>
<!--
  W4 (App-Lane C): values-en/strings.xml — English je Key für
  res/values/strings.xml (deutsche Default-Fassung) + die Lane-C-Keys
  (chat_tab_*, mediathek_*, settings_language_title, settings_language_desc,
  language_option_*). Die resources/values-en/ DECKT damit ALLE Keys des
  Basis-strings.xml + meiner Keys ab. Andere Lanes führen EIGENE values-en-
  Dateien im SELBEN Directory (res/values-en/merged im Build, je Key genau
  EINE Quelle — W4-Konvention, cf. onboarding_multi_server.xml von Lane D):
  deren Keys NICHT hier doppelt aufführen (Duplicate-Ressourcen = aapt-Fehler).
-->
<resources>
    <string name="app_name">FlipsiBridge</string>
    <string name="tagline">Your agent on your phone — hands, eyes and voice.</string>

    <string name="accessibility_description">FlipsiBridge accessibility service — lets the agent read the screen and operate the device.</string>

    <string name="section_status">Status</string>
