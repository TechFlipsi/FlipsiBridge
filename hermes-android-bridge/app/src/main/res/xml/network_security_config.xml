<?xml version="1.0" encoding="utf-8"?>
<!--
  FlipsiBridge Netzwerk-Härtung:
  - Standard: Klartext (HTTP/ws) VERBOTEN — auch im LAN.
  - Ausnahme: direkte LAN-Verbindung zum Agent-Host im Heim-LAN
    (private IP-Range, im Setup-Dialog der App konfigurierbar),
    weil das Hermes-Dashboard lokal nur HTTP spricht. Alles andere
    (eigene Relay-Domain & Co) läuft über HTTPS/WSS mit echtem Zertifikat.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Heim-LAN-IP des Agent-Servers (RFC1918, nicht identifizierend) -->
        <domain includeSubdomains="false">jarvis.lan</domain>
    </domain-config>
</network-security-config>