<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- ── Kopf ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif" />

        <Button
            android:id="@+id/btnChat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_orange"
            android:text="@string/open_chat"
            android:textColor="@color/text_on_accent"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <!-- ── Status ───────────────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_status" />

            <LinearLayout style="@style/StatusRow">
                <View
                    android:id="@+id/indicatorA11y"
                    style="@style/StatusDot" />
                <TextView
                    style="@style/StatusLabel"
                    android:text="@string/status_a11y" />
                <TextView
                    android:id="@+id/tvA11yStatus"
                    style="@style/StatusValue" />
            </LinearLayout>

            <LinearLayout style="@style/StatusRow">
                <View
                    android:id="@+id/indicatorServer"
                    style="@style/StatusDot" />
                <TextView
                    style="@style/StatusLabel"
                    android:text="@string/status_server" />
                <TextView
                    android:id="@+id/tvServerStatus"
                    style="@style/StatusValue" />
            </LinearLayout>

            <LinearLayout style="@style/StatusRow">
                <View
                    android:id="@+id/indicatorRelay"
                    style="@style/StatusDot" />
                <TextView
                    style="@style/StatusLabel"
                    android:text="@string/status_relay" />
                <TextView
                    android:id="@+id/tvRelayAddr"
                    style="@style/StatusValue" />
            </LinearLayout>

            <LinearLayout style="@style/StatusRow">
                <View
                    android:id="@+id/indicatorAuth"
                    style="@style/StatusDot" />
                <TextView
                    style="@style/StatusLabel"
                    android:text="@string/status_auth" />
                <TextView
                    android:id="@+id/tvAuthCode"
                    style="@style/StatusValue" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Berechtigungen ───────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_permissions" />

            <LinearLayout style="@style/PermRow">
                <LinearLayout style="@style/PermTextCol">
                    <TextView
                        style="@style/PermTitle"
                        android:text="@string/perm_a11y_title" />
                    <TextView
                        style="@style/PermDesc"
                        android:text="@string/perm_a11y_desc" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switchAccessibility"
                    style="@style/PermSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/PermRow">
                <LinearLayout style="@style/PermTextCol">
                    <TextView
                        style="@style/PermTitle"
                        android:text="@string/perm_overlay_title" />
                    <TextView
                        style="@style/PermDesc"
                        android:text="@string/perm_overlay_desc" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switchOverlay"
                    style="@style/PermSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/PermRow">
                <LinearLayout style="@style/PermTextCol">
                    <TextView
                        style="@style/PermTitle"
                        android:text="@string/perm_screenrec_title" />
                    <TextView
                        style="@style/PermDesc"
                        android:text="@string/perm_screenrec_desc" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switchScreenRecord"
                    style="@style/PermSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/PermRow">
                <LinearLayout style="@style/PermTextCol">
                    <TextView
                        style="@style/PermTitle"
                        android:text="@string/perm_revival_title" />
                    <TextView
                        style="@style/PermDesc"
                        android:text="@string/perm_revival_desc" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switchRevival"
                    style="@style/PermSwitch" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Verbindung ───────────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_connection" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conn_hint"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:hint="@string/conn_url_hint"
                android:inputType="textUri"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/tvRelayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_button_orange"
                    android:text="@string/conn_connect"
                    android:textColor="@color/text_on_accent"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_disconnect"
                    android:text="@string/conn_disconnect"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Pairing ──────────────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_pairing" />

            <TextView
                android:id="@+id/tvPairingCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:letterSpacing="0.25"
                android:textColor="@color/accent"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pairing_hint"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnRegenerate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_orange"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/pairing_regen"
                android:textAllCaps="false"
                android:textColor="@color/text_on_accent"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ── Fuß ──────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>